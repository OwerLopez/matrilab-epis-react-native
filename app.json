{
  "expo": {
    "name": "MatriLab EPIS",
    "slug": "matrilab-epis",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.edu.unsa.epis.matrilab"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#19375A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pe.edu.unsa.epis.matrilab"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "matrilab",
    "description": "Matrícula de laboratorios de la EPIS-UNSA: catálogo con vacantes en vivo, validación de cruces, pase QR y control de asistencia.",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "MatriLab usa la cámara para leer los pases QR de asistencia."
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/matrilab-epis-react-native"
    }
  }
}
